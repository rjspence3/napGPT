# Anthropic API Configuration (default provider)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model (optional, defaults to claude-sonnet-4-5)
NAPGPT_MODEL=claude-sonnet-4-5

# Maximum tokens per response (optional, defaults to 300)
NAPGPT_MAX_TOKENS=300

# To use OpenAI instead, set:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-your-key-here
# NAPGPT_MODEL=gpt-4o-mini
