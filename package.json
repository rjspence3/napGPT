{
  "name": "napgpt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:nap-gpt": "next dev -p 3000",
    "dev:monitored": "node scripts/monitor.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:ui": "playwright test tests/e2e/ui-elements.spec.ts",
    "test:api": "playwright test tests/e2e/api-button-tests.spec.ts",
    "test:ui-cdp": "tsx tests/e2e/ui-elements-cdp.ts",
    "test:mcp-cdp": "tsx tests/e2e/mcp-cdp-retest.ts",
    "test:llm-chats": "tsx tests/e2e/llm-chat-scenarios.ts",
    "inspect:ui": "tsx tests/e2e/inspect-ui.ts",
    "test:mcp": "MCP_DRIVER=puppeteer tsx scripts/mcp/run-mcp-tests.ts",
    "test:mcp:mcp": "MCP_DRIVER=server MCP_WS=ws://localhost:9222/devtools/browser tsx scripts/mcp/run-mcp-tests.ts",
    "test:mcp:headful": "HEADFUL=1 MCP_DRIVER=puppeteer tsx scripts/mcp/run-mcp-tests.ts",
    "test:mcp:report": "node scripts/mcp/build-report.js",
    "test:ui-legacy": "tsx scripts/test-all-ui-elements.ts",
    "test:ui-legacy:headful": "HEADFUL=1 tsx scripts/test-all-ui-elements.ts",
    "test:visual": "tsx scripts/test-visual-baselines.ts",
    "test:visual:headful": "HEADFUL=1 tsx scripts/test-visual-baselines.ts",
    "test:a11y": "tsx scripts/test-accessibility.ts",
    "test:budgets": "tsx scripts/test-behavior-budgets.ts",
    "test:perf": "tsx scripts/test-performance.ts",
    "test:report": "tsx scripts/build-html-index.ts",
    "test:ui:headless": "TS_NODE_TRANSPILE_ONLY=1 tsx scripts/ui-test/run-all.ts",
    "test:ui:headful": "HEADFUL=1 TS_NODE_TRANSPILE_ONLY=1 tsx scripts/ui-test/run-all.ts",
    "test:ui:live": "LIVE_LLM=1 TS_NODE_TRANSPILE_ONLY=1 tsx scripts/ui-test/run-all.ts --live",
    "test:ui:live:all": "LIVE_LLM=1 TS_NODE_TRANSPILE_ONLY=1 tsx scripts/ui-test/run-all.ts --live",
    "test:ui:live:jest": "LIVE_LLM=1 jest --runInBand tests/ui",
    "test:ui:mcp": "MCP_DRIVER=server TS_NODE_TRANSPILE_ONLY=1 tsx scripts/ui-test/run-all.ts",
    "test:ui:report": "tsx scripts/ui-test/report.ts",
    "test:ui:budget-gate": "tsx scripts/ui-test/budget-gate.ts",
    "test:ui:flake-guard": "tsx scripts/ui-test/flake-guard.ts",
    "test:ui-all": "jest --runInBand",
    "test:ui-all:headful": "HEADFUL=1 jest --runInBand",
    "test:ui-live": "LIVE_LLM=1 jest --runInBand tests/ui/chat.live.spec.ts",
    "test:ui-live:headful": "HEADFUL=1 LIVE_LLM=1 jest --runInBand tests/ui/chat.live.spec.ts",
    "test:ui-live:matrix": "LIVE_LLM=1 MODEL_MATRIX=\"openai:gpt-4o-mini,anthropic:claude-3-haiku\" jest --runInBand tests/ui/chat.live.spec.ts",
    "test:ui-live:chaos": "LIVE_LLM=1 CHAOS_LATENCY_MS=1200 CHAOS_FAIL_PCT=10 CHAOS_429_PCT=10 jest --runInBand tests/ui/chat.live.spec.ts",
    "test:ui-failpack": "JEST_FAILPACK=1 jest --runInBand tests/ui/failpack",
    "test:serve-llm": "tsx tests/mocks/server.ts",
    "ci:lighthouse": "lhci autorun --upload.target=filesystem",
    "ci:verify": "npm run test:ui-all && npm run ci:lighthouse",
    "test:guardrails": "tsx tests/utils/run-guardrails.ts"
  },
  "dependencies": {
    "@vercel/kv": "^3.0.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.344.0",
    "next": "^15.5.12",
    "openai": "^4.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.41.0",
    "@sinonjs/fake-timers": "^15.0.0",
    "@types/glob": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.24",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.17",
    "chrome-devtools-mcp": "^0.10.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.0",
    "glob": "^11.0.3",
    "jest": "^29.7.0",
    "jest-image-snapshot": "^6.5.1",
    "jest-puppeteer": "^11.0.0",
    "lighthouse": "^12.8.2",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.35",
    "puppeteer": "^24.29.0",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "yaml": "^2.8.1"
  }
}
